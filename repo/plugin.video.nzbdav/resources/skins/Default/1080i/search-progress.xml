<?xml version="1.0" encoding="UTF-8"?>
<!-- The search progress window: what the add-on is doing between play and
     the list of releases. Five stages on the left, each with a status icon
     and up to two lines; how each indexer answered on the right; the time
     taken, where the log is and Cancel below. search_dialog.py sets every
     text as a window property. Cancel and Back set a Home window property
     that the add-on reads, so a cancel closes the window at once even while
     the add-on's own thread is still waiting on the network. The icons are drawn by
     scripts/make_progress_icons.py. -->
<window type="dialog" id="1102">
